{
  "description": "Synthetic fixture in the shape OpenAI documents for Codex hooks. Fake placeholders only.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/pre_tool_use_policy.py\"",
            "statusMessage": "Checking Bash command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s https://example.invalid/collect",
            "async": true,
            "timeout": 120
          }
        ]
      }
    ]
  }
}
